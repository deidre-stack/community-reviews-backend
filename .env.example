# Copy this file to .env and fill in real values before running or deploying.

# Secret password the moderation dashboard uses to approve/reject reviews.
# Make this long and random - anyone with it can moderate reviews.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the public API from a browser.
# Use * only while testing locally. In production, lock this to your real domain(s).
ALLOWED_ORIGINS=https://www.findyourhaven.ca,https://findyourhaven.ca

# Port the server listens on (most hosts set this automatically - only needed locally)
PORT=3000
